# Copiar a .env y ajustar. Sin .env, el proyecto usa SQLite y valores por defecto.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=postgresql activa PostgreSQL (usado por docker-compose).
# Si se omite, se usa SQLite en desarrollo y tests.
DB_ENGINE=postgresql
DB_NAME=support_desk
DB_USER=support_desk
DB_PASSWORD=support_desk
DB_HOST=localhost
DB_PORT=5433
